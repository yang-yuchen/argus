@inproceedings{triton,
  address      = {Phoenix AZ USA},
  title        = {Triton: an intermediate language and compiler for tiled
                  neural network computations},
  isbn         = {978-1-4503-6719-6},
  url          = {https://dl.acm.org/doi/10.1145/3315508.3329973},
  doi          = {10.1145/3315508.3329973},
  abstractnote = {The validation and deployment of novel research ideas in
                  the field of Deep Learning is often limited by the
